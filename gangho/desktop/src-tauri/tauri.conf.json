{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gangho",
  "mainBinaryName": "Gangho",
  "version": "0.1.0",
  "identifier": "com.dooganzzz.gangho",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "강호견문록", "width": 1280, "height": 860, "minWidth": 960, "minHeight": 640, "resizable": true, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
